{
  "name": "dsh-knowledge-center",
  "version": "1.8.4",
  "description": "Knowledge Center (知识中心) plugin for DeepSeek Harness: distill workspace documents into Markdown knowledge notes, preview them like VS Code, and let permitted workspaces use them through agent tools.",
  "type": "module",
  "license": "MIT",
  "author": "dsh-knowledge-center contributors",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "knowledge-center",
    "knowledge-base",
    "repo-wiki",
    "markdown",
    "agent-tools"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "docs/fixes-2026-10-25.md",
    "docs/VERIFICATION.md",
    "docs/EXTRACTION.md",
    "test.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=20.3.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-shell"
      ]
    }
  }
}
